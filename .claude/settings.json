{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew build *)",
      "Bash(./gradlew build)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew test)",
      "Bash(./gradlew check *)",
      "Bash(./gradlew check)",
      "Bash(./gradlew compileJava *)",
      "Bash(./gradlew compileJava)",
      "Bash(./gradlew compileTestJava)",
      "Bash(./gradlew spotlessApply *)",
      "Bash(./gradlew spotlessApply)",
      "Bash(./gradlew spotlessCheck)",
      "Bash(./gradlew bootRun *)",
      "Bash(./gradlew bootRun)",
      "Bash(./gradlew dependencies *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose up -d)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(curl -s http://localhost:*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(docker compose down *)",
      "Bash(docker compose down)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.staging)",
      "Read(./.env.prod)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.dev)",
      "Edit(./.env.staging)",
      "Edit(./.env.prod)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*firebase*.json)",
      "Read(./**/*service-account*.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(./gradlew flywayClean *)",
      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)"
    ]
  },
  "env": {
    "SPRING_PROFILES_ACTIVE": "dev"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh" }]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mark-java-changed.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-java.sh", "timeout": 180 }]
      }
    ]
  }
}
