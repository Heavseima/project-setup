# Copy to .env and fill in real values. Never commit .env.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (docker-compose defaults)
DB_URL=jdbc:postgresql://localhost:5432/hrd_intelligence
DB_USERNAME=hrd
DB_PASSWORD=change-me

# External auth server (issues tokens; this app only validates them)
JWT_ISSUER_URI=https://auth.example.com/realms/hrd
JWT_JWK_SET_URI=https://auth.example.com/realms/hrd/protocol/openid-connect/certs
JWT_AUDIENCES=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# External data APIs
RDA_API_URL=https://rda.example.com
RDA_API_KEY=change-me
ASSESSMENT_API_URL=https://assessment.example.com
ASSESSMENT_API_KEY=change-me

# File storage (docker-compose MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=hrd-documents

# Email (docker-compose Mailpit in dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Push notifications (path to Firebase service-account JSON, kept outside the repo)
FCM_CREDENTIALS_PATH=
